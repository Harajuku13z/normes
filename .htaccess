RewriteEngine On

# 1. Strip trailing slash FIRST (visible 301) before rewriting to public/
#    Without this, public/.htaccess fires its own trailing-slash redirect AFTER
#    the internal rewrite, which exposes /public/ in the browser URL.
RewriteCond %{REQUEST_URI} !^/public/
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)/+$ /$1 [R=301,L]

# 2. Internal rewrite to public/ subfolder (no trailing slash at this point)
RewriteCond %{REQUEST_URI} !^/public/
RewriteRule ^(.*)$ public/$1 [L,QSA]
