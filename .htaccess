RewriteEngine On

# Redirect the legacy solar URL to the kept photovoltaic simulator URL.
RewriteRule ^simulateur-solaire/?$ /simulateur-photovoltaique [R=301,L]

# Redirect /public/simulateur-photovoltaique/... back to the clean URL.
RewriteRule ^public/simulateur-photovoltaique(/.*)?$ /simulateur-photovoltaique$1 [R=301,L]

# 1. Strip trailing slash FIRST (visible 301) before rewriting to public/
#    Without this, public/.htaccess fires its own trailing-slash redirect AFTER
#    the internal rewrite, which exposes /public/ in the browser URL.
RewriteCond %{REQUEST_URI} !^/public/
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)/+$ /$1 [R=301,L]

# 1.5 Serve the static solar simulator directly from the project root
#     so the public URL stays /simulateur-photovoltaique without exposing /public/.
RewriteCond %{REQUEST_URI} ^/(simulateur-photovoltaique|simulateur-photovoltaique-assets)(/.*)?$ [NC]
RewriteRule ^ - [L]

# 2. Internal rewrite to public/ subfolder (no trailing slash at this point)
RewriteCond %{REQUEST_URI} !^/public/
RewriteRule ^(.*)$ public/$1 [L,QSA]
